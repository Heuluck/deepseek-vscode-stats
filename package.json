{
  "name": "deepseek-stats",
  "displayName": "DeepSeek Stats",
  "description": "在 VS Code 中查询 DeepSeek 账户余额，并查看分时 / 分天 / 分月的余额趋势图",
  "version": "0.1.0",
  "publisher": "heuluck",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "balance",
    "余额",
    "stats"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseek-stats.toggleStatusBar",
        "title": "DeepSeek Stats: 切换状态栏余额显示"
      }
    ],
    "configuration": {
      "title": "DeepSeek Stats",
      "properties": {
        "deepseek-stats.pollIntervalMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "余额轮询间隔（分钟）。VS Code 打开期间按此间隔自动查询余额。"
        },
        "deepseek-stats.statusBar.show": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏显示余额。"
        },
        "deepseek-stats.statusBar.defaultColor": {
          "type": "string",
          "default": "",
          "format": "color",
          "description": "状态栏余额默认颜色（不匹配任何阈值时）。留空则跟随主题默认颜色。"
        },
        "deepseek-stats.statusBar.thresholds": {
          "type": "array",
          "default": [
            {
              "below": 10,
              "color": "#e51400"
            },
            {
              "below": 50,
              "color": "#ffb900"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "below": {
                "type": "number",
                "description": "余额低于此值（不含）时使用该颜色"
              },
              "color": {
                "type": "string",
                "format": "color",
                "description": "颜色"
              }
            },
            "required": [
              "below",
              "color"
            ]
          },
          "description": "按余额阈值设置状态栏颜色。按顺序匹配第一条满足 below 的规则。"
        },
        "deepseek-stats.history.rawRetentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "原始分钟级快照保留天数（分时视图数据来源）。更早的数据会自动滚动聚合为按天记录。"
        },
        "deepseek-stats.showTodaySpend": {
          "type": "boolean",
          "default": false,
          "description": "在面板头部显示今日花费（估算值，可能因充值或数据断档而不准确，需在设置中同意后启用）。"
        },
        "deepseek-stats.chart.connectorStyle": {
          "type": "string",
          "enum": [
            "dashed",
            "dotted",
            "solid",
            "ignore",
            "none"
          ],
          "enumDescriptions": [
            "虚线连接断点（默认）",
            "点虚线连接断点",
            "实线连接断点",
            "假装连续：把断档当作正常连续数据绘制",
            "不连接断点"
          ],
          "default": "dashed",
          "description": "图表中数据断点（缺口）的连接线样式。"
        },
        "deepseek-stats.chart.connectorColor": {
          "type": "string",
          "default": "",
          "format": "color",
          "description": "图表断点连接线颜色。留空则跟随图表主线条颜色。"
        },
        "deepseek-stats.chart.lineStyle": {
          "type": "string",
          "enum": [
            "straight",
            "smooth"
          ],
          "enumDescriptions": [
            "直线连接（默认）",
            "平滑曲线连接"
          ],
          "default": "straight",
          "description": "图表主线条的绘制方式：直线或平滑曲线。"
        },
        "deepseek-stats.dayBoundary": {
          "type": "string",
          "enum": [
            "local",
            "utc"
          ],
          "enumDescriptions": [
            "本地时区（默认）：按本地自然日计算「今日花费」",
            "UTC：与 DeepSeek 官方用量口径一致（UTC 日界）"
          ],
          "default": "local",
          "description": "「今日花费」的日界时区。DeepSeek 官方按 UTC 计算每日用量，选择 UTC 可让今日花费与官方口径一致。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p webview/tsconfig.json && node build.mjs",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node build.mjs --watch",
    "build:webview": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:webview": "tsc -p webview/tsconfig.json",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "0.0.46-24",
    "esbuild": "^0.28.1",
    "esbuild-plugin-solid": "^0.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "d3-shape": "^3.2.0",
    "solid-js": "^1.9.14"
  }
}
